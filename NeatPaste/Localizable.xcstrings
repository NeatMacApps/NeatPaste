{
  "sourceLanguage": "en",
  "strings": {
    "about.credits": {
      "comment": "About panel credits",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS clipboard history manager. Unrelated to the iOS text-cleaning app of the same name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 剪贴板历史工具。与同名 iOS 文本清理应用无关。"
          }
        }
      }
    },
    "hotkey.key.space": {
      "comment": "Hotkey display name for Space",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格"
          }
        }
      }
    },
    "hotkey.key.unknown": {
      "comment": "Fallback hotkey key name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键"
          }
        }
      }
    },
