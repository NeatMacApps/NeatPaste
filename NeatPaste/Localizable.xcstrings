    "panel.search.clear": {
      "comment": "Clear search field",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除搜索"
          }
        }
      }
    },
    "panel.search.placeholder": {
      "comment": "Search field placeholder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "recovery.running.detail": {
      "comment": "Recovery window running explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history is still being recorded. Show the menu bar icon to get the panel back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史仍在收录。打开「显示菜单栏图标」即可重新唤出面板。"
          }
        }
      }
    },
    "recovery.running.title": {
      "comment": "Recovery window running status",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeatPaste is still running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeatPaste 仍在运行"
          }
        }
      }
    },
    "recovery.title": {
      "comment": "Recovery window title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeatPaste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeatPaste"
          }
        }
      }
    },
    "settings.hotkey.clear": {
      "comment": "Clear hotkey button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        }
      }
    },
    "settings.hotkey.cleared": {
      "comment": "Hotkey cleared state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除"
          }
        }
      }
    },
    "settings.hotkey.current": {
      "comment": "Current hotkey accessibility label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current global shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前全局唤起快捷键"
          }
        }
      }
    },
    "settings.hotkey.hint": {
      "comment": "Hotkey idle hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this anytime. Common macOS shortcuts are reserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时修改；不会占用 macOS 的常用组合。"
          }
        }
      }
    },
    "settings.hotkey.initFailed": {
      "comment": "Hotkey handler init failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The global shortcut could not start. Please relaunch NeatPaste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键无法初始化，请重新启动 NeatPaste。"
          }
        }
      }
    },
    "settings.hotkey.needModifier": {
      "comment": "Hotkey requires a modifier",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Command, Option, Control, or Shift as well."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时按住 Command、Option、Control 或 Shift。"
          }
        }
      }
    },
    "settings.hotkey.record": {
      "comment": "Record hotkey button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制新快捷键"
          }
        }
      }
    },
    "settings.hotkey.recording": {
      "comment": "Recording hotkey button title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录制…"
          }
        }
      }
    },
    "settings.hotkey.recordingHint": {
      "comment": "Recording hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the new shortcut now. Press Escape to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在按下新的组合键；按 Escape 取消。"
          }
        }
      }
    },
    "settings.hotkey.reserved": {
      "comment": "System reserved shortcut",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination is reserved by macOS. Choose another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合由 macOS 保留，请换一个组合。"
          }
        }
      }
    },
    "settings.hotkey.restore": {
      "comment": "Restore default hotkey",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        }
      }
    },
    "settings.hotkey.section": {
      "comment": "Settings section: global shortcut",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global Shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键"
          }
        }
      }
    },
    "settings.hotkey.taken": {
      "comment": "Shortcut already in use",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination is already used by macOS or another app. Choose another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合已被 macOS 或其他应用占用，请换一个组合。"
          }
        }
      }
    },
    "settings.ignoredApps.empty": {
      "comment": "Empty ignored apps list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ignored apps yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有忽略的应用。"
          }
        }
      }
    },
    "settings.ignoredApps.footnote": {
      "comment": "Ignored apps coming soon",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies from listed apps will be ignored. Adding apps arrives in the next update; the setting is already saved in one place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自这些应用的复制会被忽略。添加应用会在下一波接入；设置键已经集中存放。"
          }
        }
      }
    },
    "settings.ignoredApps.section": {
      "comment": "Ignored apps section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignored Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略的应用"
          }
        }
      }
    },
    "settings.launchAtLogin.failed": {
      "comment": "Launch at login update failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update launch at login. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机自启动更新失败，请稍后重试。"
          }
        }
      }
    },
    "settings.launchAtLogin.needsApproval": {
      "comment": "Login item waiting for approval",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is waiting for approval. Allow NeatPaste in System Settings → General → Login Items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机自启动等待系统批准。请在「系统设置 › 通用 › 登录项」中允许 NeatPaste。"
          }
        }
      }
    },
    "settings.launchAtLogin.openSettings": {
