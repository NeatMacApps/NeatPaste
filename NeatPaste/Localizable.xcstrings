            "value": "图片"
          }
        }
      }
    },
    "panel.preview.title": {
      "comment": "System preview window title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览"
          }
        }
      }
