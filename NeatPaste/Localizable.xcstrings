          "stringUnit": {
            "state": "translated",
            "value": "开机自启动"
          }
        }
      }
    },
    "menu.openPanel": {
      "comment": "Status menu open panel",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开面板"
          }
        }
      }
    },
    "menu.quit": {
      "comment": "Status menu quit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit NeatPaste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 NeatPaste"
          }
        }
      }
    },
    "menu.settings": {
      "comment": "Status menu settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "panel.accessibility.body": {
      "comment": "How to grant Accessibility",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste automatically, allow NeatPaste in System Settings → Privacy & Security → Accessibility. You can still press ⌘V yourself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要自动粘贴，请在「系统设置 › 隐私与安全性 › 辅助功能」中允许 NeatPaste。你仍然可以自己按 ⌘V。"
          }
        }
      }
    },
    "panel.accessibility.openSettings": {
      "comment": "Open Accessibility settings button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "panel.accessibility.title": {
      "comment": "Accessibility prompt title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic paste needs permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动粘贴需要授权"
          }
        }
      }
    },
    "panel.copiedOnly": {
      "comment": "Copied to clipboard without auto-paste",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item was copied to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目已写入系统剪贴板。"
          }
        }
      }
    },
    "panel.history.delete": {
      "comment": "Context menu: delete one history item immediately, no confirmation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "panel.history.empty": {
      "comment": "Empty history list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something. It will show up here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制任意内容，就会出现在这里。"
          }
        }
      }
    },
    "panel.image.placeholder": {
      "comment": "List title and accessibility label when the item is an image without a readable name",
